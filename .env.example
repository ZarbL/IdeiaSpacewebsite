# =============================================================================
# IdeiaSpace Website — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha apenas o que for usar:
#
#   cp .env.example .env.local
#
# Todas as variáveis são opcionais. Com os valores vazios abaixo, o site roda
# com os mesmos comportamentos de fallback de um ambiente sem configuração.
#
# Nunca versione .env.local nem coloque valores reais neste arquivo.
# Detalhes: README.md (Variáveis de ambiente) e docs/ARQUITETURA.md (seção 7).


# -----------------------------------------------------------------------------
# Públicas (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# Vão para o JavaScript enviado ao navegador: NUNCA coloque segredos aqui.
# São lidas durante o build (e ao iniciar o `next dev`): alterar o valor exige
# um novo build ou reiniciar o servidor de desenvolvimento.

# "true" serve imagens e vídeos mapeados pelo Cloudinary (src/lib/cloudinary.ts).
# Qualquer outro valor usa caminhos locais /assets/... — nesse modo os vídeos
# não carregam (ver docs/ARQUITETURA.md, seção 8).
NEXT_PUBLIC_USE_CLOUDINARY=

# Nome da conta Cloudinary usada nas URLs de mídia.
# Vazio: o código usa o valor padrão definido em src/lib/cloudinary.ts.
# Também é usado por scripts/upload-to-cloudinary.js.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


# -----------------------------------------------------------------------------
# Servidor / API (lidas apenas pelos Route Handlers em src/app/api)
# -----------------------------------------------------------------------------

# Chave da Resend para enviar o e-mail do formulário de contato (/api/contact).
# Vazio: a API responde com um link mailto: em vez de enviar o e-mail.
RESEND_API_KEY=

# Chave da API N2YO para buscar TLEs dos grupos stations, starlink e weather
# (/api/satellites). Vazio: a API devolve dados TLE estáticos de fallback.
N2YO_API_KEY=

# Credenciais do Space-Track.org para os TLEs do grupo ideiaspace
# (/api/satellites). Vazio: a API devolve dados TLE estáticos de fallback.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=


# -----------------------------------------------------------------------------
# Scripts locais (não usadas pela aplicação)
# -----------------------------------------------------------------------------
# Usadas apenas por `npm run upload:cloudinary` (scripts/upload-to-cloudinary.js),
# junto com NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME. O script lê somente .env.local.

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# Código não utilizado
# -----------------------------------------------------------------------------
# Lida por src/lib/wordpress.ts, que não é importado por nenhuma página ou API.
# Definir esta variável não altera o comportamento atual do site.

# WORDPRESS_API_URL=
